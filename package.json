{
  "name": "gem-gallery",
  "productName": "图库",
  "version": "1.0.1",
  "private": true,
  "description": "通用图片管理与壁纸工具 — 多源采集 / pHash 去重 / 暗色图片库",
  "author": "图库",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web,app -c magenta,cyan,green \"node server/index.js\" \"vite\" \"electron . --dev-url=http://localhost:5173\"",
    "dev:web": "concurrently -n server,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron .",
    "desktop:hmr": "electron . --dev-url=http://localhost:5173",
    "mcp": "node server/mcp-server.mjs",
    "import": "node server/scripts/import-local.js",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "node scripts/lint.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run smoke",
    "test": "npm run verify"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "call-bind-apply-helpers": "^1.0.2",
    "decompress-tar": "^4.1.1",
    "decompress-tarbz2": "^4.1.1",
    "decompress-targz": "^4.1.1",
    "decompress-unzip": "^4.0.1",
    "express": "^5.1.0",
    "jpegtran-bin": "^7.0.0",
    "lru-cache": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.3",
    "sharp": "^0.34.2",
    "side-channel-list": "^1.0.0",
    "side-channel-map": "^1.0.1",
    "side-channel-weakmap": "^1.0.2",
    "yallist": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.gem.gallery",
    "productName": "图库",
    "directories": {
      "output": "release-build",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/web/**/*",
      "package.json",
      "build/icon.ico",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/jpegtran-bin/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/semver/**",
      "**/node_modules/detect-libc/**"
    ],
    "compression": "maximum",
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "图库",
      "artifactName": "Gallery-Setup-${version}.exe"
    }
  }
}
